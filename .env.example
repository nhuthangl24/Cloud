AUTH_USERNAME=admin
AUTH_PASSWORD=ChangeMe123!
# Recommended for production: set AUTH_PASSWORD_HASH and remove AUTH_PASSWORD
# Format: scrypt$<salt>$<hex_hash> (generate via `npm run hash-password -- "your-password"`)
AUTH_PASSWORD_HASH=
AUTH_SECRET=change-this-auth-secret-in-env-for-production-min32chars
SESSION_TTL_HOURS=24

# Telegram Bot configuration
# Single bot token or comma-separated list of multiple bot tokens for load balancing:
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKENS=
TELEGRAM_STORAGE_CHAT_ID=

# MongoDB database connection string
MONGODB_URI=mongodb://127.0.0.1:27017/cloud

# Storage & Quota limits
MAX_FILE_SIZE=52428800
ALLOWED_MIME_TYPES=*/*
DEFAULT_STORAGE_QUOTA=5497558138880
PUBLIC_APP_URL=http://localhost:3000
PRIVATE_LINKS_ONLY=true
